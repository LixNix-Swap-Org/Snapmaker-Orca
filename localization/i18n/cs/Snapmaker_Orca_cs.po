msgstr "Hlavní poloosa"

# AI Translated
msgid "Semi-minor axis"
msgstr "Vedlejší poloosa"

# AI Translated
msgid "The angle must be between 0° and 360°"
msgstr "Úhel musí být mezi 0° a 360°"

# AI Translated
msgid "The semi-major axis cannot be shorter than the semi-minor axis"
msgstr "Hlavní poloosa nemůže být kratší než vedlejší poloosa"

