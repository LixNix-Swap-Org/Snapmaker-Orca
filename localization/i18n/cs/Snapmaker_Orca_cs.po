msgstr "Prodloužit: klikněte na čáru nebo oblouk, který může dosáhnout jiné entity"

# AI Translated
msgid "Trim: click a segment where it crosses another entity"
msgstr "Oříznout: klikněte na úsek v místě, kde kříží jinou entitu"

# AI Translated
msgid "Press Enter or ✓ to apply, Esc to discard"
msgstr "Stiskněte Enter nebo ✓ pro použití, Esc pro zahození"

