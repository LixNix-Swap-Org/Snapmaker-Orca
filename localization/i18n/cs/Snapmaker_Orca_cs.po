#, boost-format
msgid "%1% constraint cannot act on this geometry (an ellipse or spline curve, or a zero-size circle) and is ignored"
msgid_plural "%1% constraints cannot act on this geometry (an ellipse or spline curve, or a zero-size circle) and are ignored"
msgstr[0] "%1% vazba nemůže působit na tuto geometrii (elipsu nebo křivku spline, případně kružnici nulové velikosti) a je ignorována"
msgstr[1] "%1% vazby nemohou působit na tuto geometrii (elipsu nebo křivku spline, případně kružnici nulové velikosti) a jsou ignorovány"
msgstr[2] "%1% vazeb nemůže působit na tuto geometrii (elipsu nebo křivku spline, případně kružnici nulové velikosti) a je ignorováno"

