msgstr[1] "%1% vazby, které zaoblení/zkosení zneplatnilo, byly odstraněny"
msgstr[2] "%1% vazeb, které zaoblení/zkosení zneplatnilo, bylo odstraněno"

# AI Translated
msgid "Offset: an ellipse or a spline has no parallel of its own kind — pick lines, arcs or circles"
msgstr "Odsazení: elipsa ani spline nemají rovnoběžnou křivku stejného druhu — vyberte čáry, oblouky nebo kružnice"

# AI Translated
msgid "The scale factor must be greater than zero"
msgstr "Faktor měřítka musí být větší než nula"

# AI Translated
msgid "Copies"
msgstr "Počet kopií"

# AI Translated
msgid "The number of copies must be a whole number, 2 or more"
msgstr "Počet kopií musí být celé číslo, 2 nebo více"

# AI Translated
#, boost-format
msgid "%1% constraint released by the transform"
msgid_plural "%1% constraints released by the transform"
msgstr[0] "%1% vazba uvolněná transformací"
msgstr[1] "%1% vazby uvolněné transformací"
msgstr[2] "%1% vazeb uvolněných transformací"

# AI Translated
msgid "The array copies are unconstrained — the solver refused every binding"
msgstr "Kopie pole nejsou vázané — řešič odmítl všechny vazby"

# AI Translated
msgid "right-click or double-click to finish, click start to close"
msgstr "dokončete pravým tlačítkem nebo dvojklikem, kliknutím na začátek uzavřete"

