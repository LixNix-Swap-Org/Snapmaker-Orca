msgid "The slot is too wide for its radius — the width must be less than twice the radius"
msgstr "Drážka je pro svůj poloměr příliš široká — šířka musí být menší než dvojnásobek poloměru"

# AI Translated
#, boost-format
msgid "%1% cannot be satisfied — the sketch is over-constrained"
msgstr "%1%: tuto kótu nelze splnit — náčrt je přeurčený"

# AI Translated
msgid "Those two lines do not meet at a corner — pick two lines that do"
msgstr "Tyto dvě čáry se nestýkají v rohu — vyberte dvě čáry, které se v rohu stýkají"

# AI Translated
