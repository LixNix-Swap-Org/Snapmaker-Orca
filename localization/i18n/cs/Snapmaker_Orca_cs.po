msgstr "Klikněte na druhý bod nebo na čáru, ke které se má změřit vzdálenost"

# AI Translated
msgid "Enter a number"
msgstr "Zadejte číslo"

# AI Translated
msgid "Not a number"
msgstr "Není číslo"

